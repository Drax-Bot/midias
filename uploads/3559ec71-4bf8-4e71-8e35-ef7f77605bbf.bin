<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Logo — Ouro Rosé</title>

<style>
* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  min-height: 100%;
}

body {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 16px;
  background: #080609;
}

.logo {
  position: relative;
  width: min(1600px, 100%);
  aspect-ratio: 16 / 9;
  overflow: hidden;
  isolation: isolate;
  container-type: inline-size;

  background:
    radial-gradient(
      ellipse at 50% 38%,
      #783c382e,
      transparent 53%
    ),
    radial-gradient(
      ellipse at 12% 85%,
      #6b26312b,
      transparent 48%
    ),
    linear-gradient(
      125deg,
      #1c1218,
      #100d12 45%,
      #08080d 78%,
      #171116
    );
}

/* Textura fina de tecido sobre o fundo. */
.logo::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;

  background:
    repeating-linear-gradient(
      35deg,
      #ffffff04 0 1px,
      transparent 1px 5px
    ),
    repeating-linear-gradient(
      125deg,
      #ffffff03 0 1px,
      transparent 1px 5px
    );

  opacity: .55;
}

/* Vinheta que concentra a iluminação no nome. */
.logo::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  box-shadow:
    inset 0 0 12cqw 3cqw #0009,
    inset 0 0 2cqw #0005;
}

.aura {
  position: absolute;
  left: 19%;
  top: 19%;
  width: 62%;
  height: 45%;
  border-radius: 50%;

  background: radial-gradient(
    ellipse,
    #ffc89125,
    #a05a3e12 48%,
    transparent 74%
  );

  filter: blur(3cqw);
}

/* Reflexos oblíquos: aparência de placas de vidro. */
.vidro {
  position: absolute;
  top: -35%;
  width: 18%;
  height: 170%;
  transform: rotate(28deg);
  pointer-events: none;

  background: linear-gradient(
    90deg,
    transparent,
    #f9c6a503 34%,
    #ffe7cc09 89%,
    #fff1db2e 99%,
    transparent
  );

  border-right: 1px solid #efc9a92b;
  box-shadow: 16px 0 45px #0003;
}

.vidro.esquerdo {
  left: 4%;
}

.vidro.direito {
  right: -3%;
  opacity: .65;
}

/* Plano luminoso sob a palavra. */
.piso {
  position: absolute;
  left: 13%;
  right: 13%;
  top: 67%;
  height: 22%;

  background: radial-gradient(
    ellipse at 50% 0,
    #d28a5c18,
    transparent 67%
  );

  border-top: 1px solid #f4c39612;
}

.arte {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.assinatura {
  position: absolute;
  left: 10%;
  right: 10%;
  bottom: 9%;
  margin: 0;

  text-align: center;
  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(7px, 1cqw, 16px);
  font-weight: 600;
  letter-spacing: .45em;

  color: #b99d91;
  text-shadow: 0 2px 6px #000;
}

.particulas {
  position: absolute;
  inset: 0;
  pointer-events: none;

  background:
    radial-gradient(
      circle at 21% 24%,
      #ffe7c4 0 1px,
      transparent 2px
    ),
    radial-gradient(
      circle at 79% 29%,
      #ffe7c4 0 1px,
      transparent 2px
    ),
    radial-gradient(
      circle at 15% 63%,
      #ffcb9c 0 1px,
      transparent 2px
    ),
    radial-gradient(
      circle at 84% 67%,
      #ffcb9c 0 1px,
      transparent 2px
    ),
    radial-gradient(
      circle at 68% 18%,
      #fff5de 0 1px,
      transparent 2px
    );

  filter: drop-shadow(0 0 5px #ffc99288);
}
</style>
</head>

<body>
<main class="logo" aria-label="Logo tipográfica em ouro rosé">
  <div class="aura"></div>
  <div class="vidro esquerdo"></div>
  <div class="vidro direito"></div>
  <div class="piso"></div>

  <svg class="arte"
       viewBox="0 0 1600 900"
       xmlns="http://www.w3.org/2000/svg"
       role="img"
       aria-labelledby="tituloArte">

    <title id="tituloArte">Logo em ouro rosé</title>

    <defs>
      <!--
        PERSONALIZE AQUI:
        substitua ÉLITE pelo nome desejado.

        Todas as camadas reutilizam este mesmo texto.
      -->
      <text id="nome"
            x="800"
            y="493"
            text-anchor="middle"
            font-family="Georgia, DejaVu Serif, serif"
            font-size="222"
            font-weight="700"
            letter-spacing="8"
            textLength="1020"
            lengthAdjust="spacingAndGlyphs">ÉLITE</text>

      <!-- Ouro rosé com reflexos claros e faixas de metal escuro. -->
      <linearGradient id="ouroRose"
                      x1="0" y1="0"
                      x2=".15" y2="1">
        <stop offset="0" stop-color="#fff6df"/>
        <stop offset=".16" stop-color="#f6d5bb"/>
        <stop offset=".32" stop-color="#d49a80"/>
        <stop offset=".455" stop-color="#895144"/>
        <stop offset=".49" stop-color="#542c27"/>
        <stop offset=".515" stop-color="#fff1d0"/>
        <stop offset=".66" stop-color="#e9b79a"/>
        <stop offset=".84" stop-color="#aa6c55"/>
        <stop offset="1" stop-color="#f7d4af"/>
      </linearGradient>

      <linearGradient id="lateral"
                      x1="0" y1="0"
                      x2="1" y2="1">
        <stop stop-color="#5d302d"/>
        <stop offset=".28" stop-color="#a06149"/>
        <stop offset=".5" stop-color="#42231f"/>
        <stop offset=".76" stop-color="#784831"/>
        <stop offset="1" stop-color="#241818"/>
      </linearGradient>

      <linearGradient id="aresta"
                      x1="0" y1="0"
                      x2="1" y2="1">
        <stop stop-color="#fff6dc"/>
        <stop offset=".32" stop-color="#d6a68c"/>
        <stop offset=".53" stop-color="#fff0ce"/>
        <stop offset="1" stop-color="#b17b61"/>
      </linearGradient>

      <linearGradient id="moldura"
                      x1="0" y1="0"
                      x2="1" y2=".6">
        <stop stop-color="#a56549" stop-opacity=".15"/>
        <stop offset=".25" stop-color="#e3bc95"/>
        <stop offset=".48" stop-color="#fff0c7"/>
        <stop offset=".7" stop-color="#ba7f60"/>
        <stop offset="1" stop-color="#ffd5ad" stop-opacity=".18"/>
      </linearGradient>

      <linearGradient id="vidroCentral"
                      x1="0" y1="0"
                      x2=".8" y2="1">
        <stop stop-color="#f3c9a8" stop-opacity=".065"/>
        <stop offset=".45" stop-color="#170e16" stop-opacity=".2"/>
        <stop offset="1" stop-color="#ffd4ad" stop-opacity=".025"/>
      </linearGradient>

      <!-- Máscara com desaparecimento gradual da reflexão. -->
      <linearGradient id="desvanecer"
                      gradientUnits="userSpaceOnUse"
                      x1="0" y1="552"
                      x2="0" y2="734">
        <stop stop-color="#ffffff" stop-opacity=".19"/>
        <stop offset=".55" stop-color="#ffffff" stop-opacity=".055"/>
        <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
      </linearGradient>

      <mask id="mascaraReflexo"
            maskUnits="userSpaceOnUse"
            x="160" y="552"
            width="1280" height="190">
        <rect x="160" y="552"
              width="1280" height="190"
              fill="url(#desvanecer)"/>
      </mask>

      <filter id="sombra"
              x="-30%" y="-50%"
              width="170%" height="230%">
        <feGaussianBlur stdDeviation="13"/>
      </filter>

      <filter id="auraMetal"
              x="-30%" y="-60%"
              width="160%" height="220%">
        <feGaussianBlur stdDeviation="7"/>
      </filter>

      <filter id="reflexoSuave"
              x="-15%" y="-50%"
              width="130%" height="200%">
        <feGaussianBlur stdDeviation="1.6"/>
      </filter>

      <filter id="brilho"
              x="-150%" y="-150%"
              width="400%" height="400%">
        <feGaussianBlur stdDeviation="4" result="luz"/>
        <feMerge>
          <feMergeNode in="luz"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!--
      Moldura aberta em losango:
      mantém o nome livre e cria uma estrutura de joalheria.
    -->
    <path d="M800 150L1350 437L800 724L250 437Z"
          fill="url(#vidroCentral)"
          stroke="#c4916c"
          stroke-opacity=".12"
          stroke-width="1"/>

    <g fill="none"
       stroke="url(#moldura)"
       stroke-width="1.5">

      <path d="M340 360L800 120L1260 360"/>
      <path d="M340 522L800 762L1260 522"/>

      <path d="M290 398L215 437L290 476"/>
      <path d="M1310 398L1385 437L1310 476"/>
    </g>

    <g fill="none"
       stroke="#e4b38e"
       stroke-opacity=".16"
       stroke-width="1">
      <path d="M425 283L800 88L1175 283"/>
      <path d="M425 604L800 799L1175 604"/>
    </g>

    <!-- Pequenos ornamentos lapidados. -->
    <g fill="url(#aresta)">
      <path d="M800 106L811 120L800 134L789 120Z"/>
      <path d="M800 748L810 762L800 776L790 762Z"/>
      <path d="M204 437L215 429L226 437L215 445Z"/>
      <path d="M1374 437L1385 429L1396 437L1385 445Z"/>
    </g>

    <!-- Sombra projetada. -->
    <use href="#nome"
         transform="translate(4 40)"
         fill="#000000"
         opacity=".85"
         filter="url(#sombra)"/>

    <!-- Halo quente atrás das letras. -->
    <use href="#nome"
         fill="none"
         stroke="#ffbe8c"
         stroke-width="5"
         opacity=".15"
         filter="url(#auraMetal)"/>

    <!-- Volume metálico em camadas. -->
    <g fill="url(#lateral)"
       stroke="#321e1b"
       stroke-width="1.5"
       stroke-linejoin="round"
       paint-order="stroke fill">
      <use href="#nome" transform="translate(0 20)"/>
      <use href="#nome" transform="translate(0 17)"/>
      <use href="#nome" transform="translate(0 14)"/>
      <use href="#nome" transform="translate(0 11)"/>
      <use href="#nome" transform="translate(0 8)"/>
      <use href="#nome" transform="translate(0 5)"/>
      <use href="#nome" transform="translate(0 2)"/>
    </g>

    <!-- Face principal em ouro rosé. -->
    <use href="#nome"
         fill="url(#ouroRose)"
         stroke="url(#aresta)"
         stroke-width="2.5"
         stroke-linejoin="round"
         paint-order="stroke fill"/>

    <!-- Filete de luz sobre as arestas. -->
    <use href="#nome"
         transform="translate(0 -1)"
         fill="none"
         stroke="#fff5dc"
         stroke-width=".7"
         opacity=".52"/>

    <!-- Reflexão no plano inferior. -->
    <g mask="url(#mascaraReflexo)">
      <use href="#nome"
           transform="translate(0 1096) scale(1 -1)"
           fill="url(#ouroRose)"
           filter="url(#reflexoSuave)"/>
    </g>

    <!-- Linhas horizontais delicadas. -->
    <g fill="none" stroke="url(#moldura)" stroke-width="1">
      <path d="M400 590H590"/>
      <path d="M1010 590H1200"/>
    </g>

    <!-- Selo geométrico central, sem texto adicional. -->
    <g transform="translate(800 604)">
      <path d="M0-18L18 0L0 18L-18 0Z"
            fill="#181017"
            stroke="url(#aresta)"
            stroke-width="1.2"/>

      <path d="M0-8L8 0L0 8L-8 0Z"
            fill="url(#ouroRose)"/>

      <path d="M-63 0H-27M27 0H63"
            stroke="#c49a79"
            stroke-opacity=".5"
            stroke-width="1"/>
    </g>

    <!-- Reflexos pontuais. -->
    <g fill="#fff1d2" filter="url(#brilho)">
      <path d="M357 315
               L360 331L376 334L360 337
               L357 353L354 337L338 334L354 331Z"/>

      <path d="M1239 446
               L1241 457L1252 459L1241 461
               L1239 472L1237 461L1226 459L1237 457Z"/>
    </g>

    <g fill="#ffffff">
      <circle cx="357" cy="334" r="1.8"/>
      <circle cx="1239" cy="459" r="1.5"/>
    </g>
  </svg>

  <div class="particulas"></div>
  <p class="assinatura">DRAX-BOT STUDIO</p>
</main>
</body>
</html>